<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="logs\**" />
    <Content Remove="logs\**" />
    <EmbeddedResource Remove="logs\**" />
    <None Remove="logs\**" />
  </ItemGroup>

  <!-- wwwroot 目录本体必须存在（Development 环境 StaticWebAssets loader 依赖；内容已改由 AspNetCore 库内嵌清单提供） -->
  <Target Name="EnsureWwwroot" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="wwwroot" Condition="!Exists('wwwroot')" />
  </Target>

  <!-- 平台库引擎 = PostgreSQL（PlatformEngine 见 Program.cs），监控引擎全开：SqlServer + MySql + PostgreSql
       （四形态冒烟矩阵的宿主：PG 平台库 × 任一被监控引擎，两轴解耦） -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DBPilot.AspNetCore\DBPilot.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\DBPilot.SqlServer\DBPilot.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\DBPilot.MySql\DBPilot.MySql.csproj" />
    <ProjectReference Include="..\..\src\DBPilot.PostgreSql\DBPilot.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

</Project>
