<Project Sdk="Microsoft.NET.Sdk">
<!-- 双目标：net8.0 降低包消费门槛，net10.0 保最优资产 -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <Description>DBPilot engine package for PostgreSQL 13+ — monitoring provider (pg_stat_* / pg_stat_statements) plus platform-store support so PostgreSQL can also host the metadata DB.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DBPilot.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBPilot.Core\DBPilot.Core.csproj" />
    <ProjectReference Include="..\DBPilot.Storage\DBPilot.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Chloe" Version="5.56.0" />
    <PackageReference Include="Chloe.PostgreSQL" Version="5.56.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- 平台库结构脚本按引擎分目录存放于 scripts/database/postgresql/，随引擎包内嵌 -->
    <EmbeddedResource Include="..\..\scripts\database\postgresql\schema.sql" LogicalName="DBPilot.PostgreSql.Scripts.schema.sql" />
    <!-- 版本化增量迁移：文件名 = V{版本}.{序号}__{描述}.sql，启动时按序执行未应用项（历史表 dbpilot_schema_version） -->
    <EmbeddedResource Include="..\..\scripts\database\postgresql\migrations\*.sql" LogicalName="DBPilot.PostgreSql.Scripts.migrations.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
