<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- MAF：ChatClientAgent（Agent 抽象） -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.17.0" />
    <!-- Microsoft.Extensions.AI 的 OpenAI 桥接：任意 OpenAI 兼容端点当 IChatClient 用 -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <!-- MCP C# SDK 客户端 -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
